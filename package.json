{
  "name": "miran-fann-dsh",
  "version": "0.1.6-beta.1",
  "description": "Miran Fann for DeepSeek Harness: the GPU motion-graphics engine as dsh tools, skills and a Miran settings section.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "motion-graphics",
    "animation",
    "video",
    "mcp"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-mcp-client": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  },
  "author": "rakibulrocky14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakibulrocky14/miran-fann-dsh.git"
  }
}
